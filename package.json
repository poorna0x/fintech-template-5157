    "build:dev": "vite build --mode development && node scripts/write-app-shell.mjs",
    "lint": "eslint .",
    "preview": "vite preview",
    "generate:sitemaps": "node scripts/generate-sitemaps.mjs",
    "test": "vitest run && npm run test:pdf-compression && npm run test:whatsapp-templates && npm run test:security",
