<?xml version="1.0" encoding="utf-8"?>
<!-- Boot-sized brand mark (48dp) used inside padded splash icon. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/boot_brand" />
            <corners android:radius="12dp" />
            <size
                android:width="48dp"
                android:height="48dp" />
        </shape>
    </item>
    <item
        android:width="28dp"
        android:height="28dp"
        android:drawable="@drawable/ic_droplets"
        android:gravity="center" />
</layer-list>
