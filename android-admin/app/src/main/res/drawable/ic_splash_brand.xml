<?xml version="1.0" encoding="utf-8"?>
<!-- System splash icon = same black Droplets mark (avoids blank white flash). -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/boot_brand" />
            <corners android:radius="22dp" />
        </shape>
    </item>
    <item
        android:drawable="@drawable/ic_droplets"
        android:gravity="center"
        android:width="44dp"
        android:height="44dp" />
</layer-list>
