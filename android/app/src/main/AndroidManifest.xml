<?xml version="1.0" encoding="utf-8" ?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <application
        android:name=".HroApplication"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">
        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation|density"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Native FCM handler: answers location-request pushes even when the
             app is killed. Replaces the Capacitor plugin's service (which it
             extends, so JS push behavior is unchanged). -->
        <service
            android:name=".HroMessagingService"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>
        <service
            android:name="com.capacitorjs.plugins.pushnotifications.MessagingService"
            tools:node="remove" />

        <!-- Handles the OTP typed into the notification's inline reply field -->
        <receiver
            android:name=".OtpReplyReceiver"
            android:exported="false" />

        <!-- After on-site dwell: wake and Ask OTP even if WebView is dead -->
        <receiver
            android:name=".AutoAskOtpAlarmReceiver"
            android:exported="false" />

        <!-- Handles free-text reply on office Message technician pushes -->
        <receiver
            android:name=".MessageReplyReceiver"
            android:exported="false" />

        <!-- Dismiss / open acknowledgments → silent or normal admin push -->
        <receiver
            android:name=".TechPushAckReceiver"
            android:exported="false" />

        <!-- Silent caller check: POSTs the incoming number to the server so
             ADMINS get notified when a customer calls a technician. Shows
             nothing on this phone. PHONE_STATE is a protected system
             broadcast, so exported=true is safe. -->
        <receiver
            android:name=".CallAlertReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.PHONE_STATE" />
            </intent-filter>
        </receiver>

        <!-- Keeps process alive (foreground short-service) to finish call-alert
             HTTP / CallLog poll when the technician app is killed. -->
        <service
            android:name=".CallAlertUploadService"
            android:exported="false"
            android:foregroundServiceType="shortService" />

        <!-- AlarmManager wake-ups retry call-alert upload if FGS start was
             blocked while the app was fully killed (Android 12+). -->
        <receiver
            android:name=".CallAlertKickReceiver"
            android:exported="false" />

        <!-- Short-lived foreground service: measures one fresh location fix
             reliably even when the app is backgrounded/killed (Android
             throttles inline background location requests to null). -->
        <service
            android:name=".LocationFixService"
            android:exported="false"
            android:foregroundServiceType="location" />

        <!-- Branded push notifications: white logo silhouette + accent color -->
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_icon"
            android:resource="@drawable/ic_stat_notify" />
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_color"
            android:resource="@color/notification_accent" />

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data android:name="android.support.FILE_PROVIDER_PATHS" android:resource="@xml/file_paths" />
        </provider>
    </application>

    <!-- Permissions -->

    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Job photos: WebView getUserMedia + file input capture="environment" -->
    <uses-permission android:name="android.permission.CAMERA" />
    <!-- Gallery pick (image/* file input) on Android 13+ -->
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" />
    <!-- Gallery pick on Android 12 and below -->
    <uses-permission
        android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />
    <!-- Legacy PDF save to public Downloads (API ≤28). Android 10+ uses MediaStore. -->
    <uses-permission
        android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="28" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <uses-feature android:name="android.hardware.camera.autofocus" android:required="false" />

    <!-- Live location tracking (background geolocation foreground service) -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_BACKGROUND_LOCATION" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SHORT_SERVICE" />
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- navigator.vibrate in the WebView (button haptics) is silently ignored without this -->
    <uses-permission android:name="android.permission.VIBRATE" />
    <!-- Assign/reassign draw-over-apps card (Truecaller-style). User must enable
         in system Settings → Display over other apps. -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <!-- Caller check: detect ringing + read the incoming number
         (Android 9+ only includes the number when READ_CALL_LOG is granted) -->
    <uses-permission android:name="android.permission.READ_PHONE_STATE" />
    <uses-permission android:name="android.permission.READ_PHONE_NUMBERS" />
    <uses-permission android:name="android.permission.READ_CALL_LOG" />
</manifest>
