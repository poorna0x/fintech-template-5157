# =============================================================================
# Copy to .env and fill in values. Use the SAME names in Netlify dashboard.
# =============================================================================

# --- Supabase (required) ---
# The anon key is intentionally public in the browser bundle (Supabase architecture).
# Security = RLS + revoked anon RPC grants (run all scripts/secure-*.sql in SQL Editor).
# Use a SEPARATE Supabase project for local dev vs production when possible.
# Dashboard: enable MFA, restrict team access; rotate anon key only with a planned redeploy.
# Must be set in Netlify → Production scope — Vite bakes these in at BUILD time (redeploy after change).
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
# Server-only (Netlify functions: technician provision/delete, not in browser):
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- Cloudinary (uploads in browser; delete via Netlify function) ---
VITE_CLOUDINARY_CLOUD_NAME=your-cloud-name
VITE_CLOUDINARY_UPLOAD_PRESET=your-upload-preset
VITE_CLOUDINARY_API_KEY=your-api-key
# For photo DELETE: set on Netlify (server). Optional locally if you use netlify dev.
CLOUDINARY_API_SECRET=your-api-secret

# Optional: secondary Cloudinary account (payment receipts — dcbxyhruv)
# VITE_CLOUDINARY_SECONDARY_CLOUD_NAME=
# VITE_CLOUDINARY_SECONDARY_UPLOAD_PRESET=
# VITE_CLOUDINARY_SECONDARY_API_KEY=
# CLOUDINARY_SECONDARY_API_SECRET=
# Signed delivery for bills/receipts: set BOTH api key + secret on Netlify (cloudinary-signed-url).
# After jobs RLS: run scripts/secure-jobs-rls.sql in Supabase SQL Editor.

# --- Google Maps (optional; maps/places) ---
# VITE_GOOGLE_MAPS_API_KEY=

# --- Email (Netlify function send-email — booking confirmations only) ---
# VITE_EMAIL_API_URL=/.netlify/functions/send-email
# FROM is fixed server-side (HOSTINGER_EMAIL_USER / ALLOWED_EMAIL_FROM). Public callers cannot set FROM/BCC/attachments.
# ALLOWED_EMAIL_FROM=noreply@hydrogenro.com
HOSTINGER_EMAIL_USER=
HOSTINGER_EMAIL_PASS=

# --- ALTCHA captcha (required for login in production) ---
# Generate: openssl rand -hex 32
# ALTCHA_HMAC_KEY=
# Optional dedicated secret for HttpOnly portal route cookie (else uses ALTCHA_HMAC_KEY):
# PORTAL_SESSION_SECRET=

# --- Auth lockout (run in Supabase SQL Editor) ---
#   scripts/add-auth-login-attempts.sql
#   scripts/secure-auth-helpers-and-is-admin-rpc.sql  (is_admin_user false for anon; revoke public RPC)
# Login uses /.netlify/functions/secure-auth-login (ALTCHA + 10/IP/hr + 5/email/15min + lockout after 5 fails).
#
# --- Supabase Dashboard (project cgpjfmbyxjetmzehkumo) — required for scanner findings ---
# Authentication → URL Configuration:
#   Site URL: https://hydrogenro.com
#   Redirect URLs (no *): https://hydrogenro.com/**, https://www.hydrogenro.com/**,
#     https://hydrogenro.netlify.app/**, http://localhost:5173/**, http://localhost:8080/**
# Authentication → Rate Limits: enable; lower sign-in/token limits if offered.
# Authentication → Attack Protection: enable (CAPTCHA / bot protection where available).
# Settings → API → CORS (REST): only your app origins (not *).
# Do not call auth/v1/token?grant_type=password from the browser — use secure-auth-login only.

# --- PostgREST error hints (run scripts/secure-postgrest-error-verbosity.sql in Supabase SQL Editor) ---
# Strips hint/details from Data API errors; reduces schema enumeration via PGRST205.

# --- Production CORS (Netlify functions — no wildcard) ---
# ALLOWED_ORIGINS=https://hydrogenro.com,https://www.hydrogenro.com,https://hydrogenro.netlify.app
# Local only: CORS_PERMISSIVE=true (netlify dev / dev-server)
# Eleven RO website-only deploy lives in repo elevenro-crm (separate Netlify site).

# --- Optional: storage provider ---
# VITE_STORAGE_PROVIDER=cloudinary

# --- Optional: analytics ---
# VITE_GA_MEASUREMENT_ID=G-XXXXXXXXXX
