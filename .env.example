# =============================================================================
# Copy to .env and fill in values. Use the SAME names in Netlify dashboard.
# =============================================================================

# --- Supabase (required) ---
# The anon key is intentionally public in the browser bundle (Supabase architecture).
# Security = RLS + revoked anon RPC grants (run all scripts/secure-*.sql in SQL Editor).
# Use a SEPARATE Supabase project for local dev vs production when possible.
# Dashboard: enable MFA, restrict team access; rotate anon key only with a planned redeploy.
# Must be set in Netlify → Production scope — Vite bakes these in at BUILD time (redeploy after change).
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
# Server-only (Netlify functions: technician provision/delete, not in browser):
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- Cloudinary (uploads in browser; delete/sign via Netlify function) ---
# Browser-safe: cloud name + UNSIGNED upload preset only.
VITE_CLOUDINARY_CLOUD_NAME=your-cloud-name
VITE_CLOUDINARY_UPLOAD_PRESET=your-upload-preset
# SECURITY: API key / API secret are server-only. NEVER prefix them with VITE_ —
# Vite would inline them into the public bundle (use-as-public is irreversible).
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_UPLOAD_PRESET=your-upload-preset
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# Optional: secondary Cloudinary account (payment receipts)
# VITE_CLOUDINARY_SECONDARY_CLOUD_NAME=
# VITE_CLOUDINARY_SECONDARY_UPLOAD_PRESET=
# CLOUDINARY_SECONDARY_CLOUD_NAME=
# CLOUDINARY_SECONDARY_UPLOAD_PRESET=
# CLOUDINARY_SECONDARY_API_KEY=
# CLOUDINARY_SECONDARY_API_SECRET=
# Signed delivery for bills/receipts: set BOTH api key + secret on Netlify (cloudinary-signed-url).
# After jobs RLS: run scripts/secure-jobs-rls.sql in Supabase SQL Editor.

# --- Google Analytics GA4 — separate property per brand (public pages only) ---
# Same Netlify deploy serves hydrogenro.com and elevenro.com; hostname picks the ID.
# VITE_GA_MEASUREMENT_ID=G-Y5TD6189X2          # Hydrogen RO (hydrogenro.com; localhost dev)
# VITE_GA_MEASUREMENT_ID_ELEVENRO=G-55B39MLJSC   # Eleven RO (elevenro.com)
# Set both in Netlify Production scope and redeploy after change.

# --- Google Maps (optional; maps/places in browser + distance-matrix Netlify function) ---
# Browser: VITE_GOOGLE_MAPS_API_KEY (restrict by HTTP referrer in Google Cloud Console).
# Server-only (distance-matrix function — preferred; key not sent from browser):
# GOOGLE_MAPS_API_KEY=
# VITE_GOOGLE_MAPS_API_KEY= also works on Netlify functions if GOOGLE_MAPS_API_KEY is unset.

# --- Email (Netlify function send-email — booking confirmations only) ---
# VITE_EMAIL_API_URL=/.netlify/functions/send-email
# FROM is fixed server-side (HOSTINGER_EMAIL_USER / ALLOWED_EMAIL_FROM). Public callers cannot set FROM/BCC/attachments.
# ALLOWED_EMAIL_FROM=noreply@hydrogenro.com
HOSTINGER_EMAIL_USER=
HOSTINGER_EMAIL_PASS=

# Admin email composer (/admin/email-preview) — optional legacy header auth.
# Preferred: logged-in admin session (Bearer JWT). Preview secret only needed for non-session tools.
# Generate: openssl rand -hex 24
# EMAIL_PREVIEW_SECRET=   # server-only; local dev email without login
# VITE_EMAIL_PREVIEW_SECRET=   # local dev ONLY — never set in Netlify Production scope

# Internal "new booking" notification (HydrogenRO + ElevenRO).
# When a public booking is confirmed, an email is sent to this address using the
# same Hostinger SMTP credentials above. Single address or comma-separated list.
# Defaults to poorna8105@gmail.com if unset.
# BOOKING_NOTIFY_EMAIL=poorna8105@gmail.com

# --- ALTCHA captcha (required for login in production) ---
# Generate: openssl rand -hex 32
# ALTCHA_HMAC_KEY=
# Dedicated secret for HttpOnly portal route cookie (recommended in production).
# Generate: openssl rand -hex 64
# If unset, falls back to ALTCHA_HMAC_KEY (existing cookies invalidate when you first set this).
# PORTAL_SESSION_SECRET=

# --- Auth lockout (run in Supabase SQL Editor) ---
#   scripts/add-auth-login-attempts.sql
#   scripts/migrate-auth-login-escalating-lockout.sql (escalating 15→30→60 min)
#   scripts/secure-auth-helpers-and-is-admin-rpc.sql  (is_admin_user false for anon; revoke public RPC)
# Login uses /.netlify/functions/secure-auth-login
#   (ALTCHA + 10 failed attempts/IP/hr + 5 failed/email/15min + escalating lockout after 5 fails).
#   Successful logins do not count toward IP/email rate limits.
# ALTCHA proof-of-work is ALWAYS required on the client (the previous "fast" server
# token path was removed — it let attackers bypass anti-automation, CVSS 8.8).
# When VITE_TURNSTILE_SITE_KEY is set, Turnstile layers on top of ALTCHA PoW.
# When TURNSTILE_SECRET_KEY is also set in Netlify, secure-auth-login rejects any
# request missing a Turnstile token (defense in depth against direct proxy abuse).

# --- Cloudflare Turnstile (required to stop brute-force on raw /auth/v1/token) ---
# Why: the public anon key in the browser bundle lets attackers call
#   https://<your-project>.supabase.co/auth/v1/token?grant_type=password DIRECTLY,
#   bypassing /.netlify/functions/secure-auth-login and all of its rate limits.
#   Enabling Supabase native CAPTCHA in the dashboard makes Supabase reject any
#   /auth/v1/token call missing a valid Turnstile token BEFORE checking the password.
#
# Setup (one-time):
#   1. https://dash.cloudflare.com → Turnstile → Add Widget
#      Widget mode: Managed (recommended) — site type "Non-Interactive" for invisible UX.
#      Hostnames: hydrogenro.com, www.hydrogenro.com, hydrogenro.netlify.app, localhost
#   2. Copy SITE KEY → set VITE_TURNSTILE_SITE_KEY below + in Netlify (Production scope), redeploy.
#   3. Copy SECRET KEY → Supabase Dashboard → Authentication → Bot and Abuse Protection
#      → enable CAPTCHA → provider "Cloudflare Turnstile" → paste secret → Save.
# Soft-deploy safety: if VITE_TURNSTILE_SITE_KEY is empty, the widget renders nothing
#   and login behaves exactly as before. Enabling Supabase CAPTCHA without this key
#   set will break login (Supabase will return 400 captcha required) — set the key
#   AND redeploy BEFORE flipping the Supabase dashboard switch.
# VITE_TURNSTILE_SITE_KEY=0x4AAAAAAAxxxxxxxxxxxxxxxx

# --- Supabase Dashboard (project cgpjfmbyxjetmzehkumo) — required for scanner findings ---
# Authentication → URL Configuration:
#   Site URL: https://hydrogenro.com
#   Redirect URLs (no *): https://hydrogenro.com/**, https://www.hydrogenro.com/**,
#     https://hydrogenro.netlify.app/**, http://localhost:5173/**, http://localhost:8080/**
# Authentication → Rate Limits (project-level):
#   Token refreshes:           default 1800 / 5 min → keep (legitimate)
#   Sign in / sign ups:        default   30 / 5 min → lower to 10 / 5 min (still per IP)
#   Token verifications:       default   30 / 5 min → lower to 10 / 5 min
#   Password recovery emails:  default    2 / 1 hr  → keep
# Authentication → Bot and Abuse Protection:
#   Enable CAPTCHA → provider "Cloudflare Turnstile" → paste Turnstile SECRET KEY.
#   (After this, every /auth/v1/token call MUST carry captcha_token — our proxy
#   already forwards it via gotrue_meta_security; the browser widget is required.)
# Settings → API → CORS (REST): only your app origins (not *).
# Do not call auth/v1/token?grant_type=password from the browser — use secure-auth-login only.

# --- PostgREST schema leak in error messages (MEDIUM / CVSS 5) ---
# Scanner: GET /rest/v1/profiles returns hint "Perhaps you meant public.reminders".
# Fix is NOT in this repo's deploy — run once in Supabase SQL Editor:
#   scripts/secure-postgrest-error-verbosity.sql
# Then verify:
#   bash scripts/verify-postgrest-error-verbosity.sh
# Browser clients also strip hint/details/message leaks in src/lib/sanitizePostgrestError.ts
# (direct curl with anon key still needs the SQL script).

# --- Production CORS (Netlify functions — no wildcard) ---
# ALLOWED_ORIGINS=https://hydrogenro.com,https://www.hydrogenro.com,https://hydrogenro.netlify.app
# Local only: CORS_PERMISSIVE=true (netlify dev / dev-server)
# Local PDF generation (Netlify generate-pdf function — headless Chrome path):
# Auto-detects Google Chrome, Brave, Edge, or Chromium on macOS/Windows/Linux.
# Override manually if needed:
# CHROME_EXECUTABLE_PATH=/Applications/Brave Browser.app/Contents/MacOS/Brave Browser
# Eleven RO website-only deploy lives in repo elevenro-crm (separate Netlify site).

# --- Optional: storage provider ---
# VITE_STORAGE_PROVIDER=cloudinary

# --- Booking phone OTP (Firebase Phone Auth — no DLT / MSG91) ---
# Enable only after Firebase project + Blaze billing + Phone Auth are set up.
# VITE_OTP_ENABLED=true
# VITE_FIREBASE_API_KEY=
# VITE_FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
# VITE_FIREBASE_PROJECT_ID=your-project-id
# VITE_FIREBASE_APP_ID=1:123456789:web:abcdef
# Server-only: paste full service account JSON (one line) from Firebase Console →
# Project settings → Service accounts → Generate new private key.
# FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account",...}
# Require verified phone before creating a job (set after testing send/verify):
# OTP_ENFORCED=true
