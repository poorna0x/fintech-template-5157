/.git/* /404.html 404!
/config.json /404.html 404!
/.env /404.html 404!
/.env.local /404.html 404!
/.env.production /404.html 404!
/.env.development /404.html 404!
/package.json /404.html 404!
/package-lock.json /404.html 404!
/composer.json /404.html 404!
/yarn.lock /404.html 404!
/.htaccess /404.html 404!
/web.config /404.html 404!
/.svn /404.html 404!
/.svn/* /404.html 404!
/node_modules/* /404.html 404!
/.aws/* /404.html 404!
/backup/* /404.html 404!
/.DS_Store /404.html 404!
/wp-config.php /404.html 404!
